{
  "name": "dsh-sidebar-manager",
  "version": "0.1.0",
  "description": "Manage the DSH left sidebar: fold the plugin-added global panel entries into a collapsible group, pin entries, or hide them — with a settings page and a one-click in-list toggle.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/local/dsh-sidebar-manager"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test test/dom.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
